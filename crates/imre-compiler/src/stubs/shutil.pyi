from os import PathLike
from typing import TypeVar

_S = TypeVar("_S", str, bytes)
_D = TypeVar("_D", bound=str | bytes | PathLike[str] | PathLike[bytes])

class Error(OSError): ...
class SameFileError(Error): ...
class SpecialFileError(OSError): ...

def which(cmd: _S | PathLike[_S], mode: int = ..., path: str | bytes | PathLike[str] | None = ...) -> _S | None: ...
def copyfile(src: str | bytes | PathLike[str] | PathLike[bytes], dst: _D, *, follow_symlinks: bool = True) -> _D: ...
