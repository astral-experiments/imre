from os import PathLike, terminal_size
from typing import BinaryIO, Callable, NamedTuple, Protocol, TextIO, TypeVar, overload

_S = TypeVar("_S", str, bytes)
_D = TypeVar("_D", bound=str | bytes | PathLike[str] | PathLike[bytes])
_TextPath = TypeVar("_TextPath", bound=PathLike[str])
_BytesPath = TypeVar("_BytesPath", bound=PathLike[bytes])

_Path = str | bytes | PathLike[str] | PathLike[bytes]

class Error(OSError): ...
class SameFileError(Error): ...
class SpecialFileError(OSError): ...
class ReadError(OSError): ...
class RegistryError(Exception): ...
class _GiveupOnFastCopy(Exception): ...

_USE_CP_SENDFILE: bool
_USE_CP_COPY_FILE_RANGE: bool
_HAS_FCOPYFILE: bool
COPY_BUFSIZE: int
def _fastcopy_sendfile(fsrc: BinaryIO | TextIO, fdst: BinaryIO | TextIO) -> None: ...
def _fastcopy_copy_file_range(fsrc: BinaryIO | TextIO, fdst: BinaryIO | TextIO) -> None: ...
def _fastcopy_fcopyfile(fsrc: BinaryIO | TextIO, fdst: BinaryIO | TextIO, flags: int) -> None: ...
def _determine_linux_fastcopy_blocksize(infd: int) -> int: ...

def copyfileobj(fsrc: BinaryIO | TextIO, fdst: BinaryIO | TextIO, length: int = 0) -> None: ...

def which(cmd: _S | PathLike[_S], mode: int = ..., path: str | bytes | PathLike[str] | None = ...) -> _S | None: ...
def copyfile(src: _Path, dst: _D, *, follow_symlinks: bool = True) -> _D: ...

def copymode(src: _Path, dst: _Path, *, follow_symlinks: bool = True) -> None: ...

def copystat(src: _Path, dst: _Path, *, follow_symlinks: bool = True) -> None: ...

def _copyxattr(src: _Path, dst: _Path, *, follow_symlinks: bool = True) -> None: ...

# copy_function is evaluated on entry but only called if a file has to be copied.
@overload
def move(src: _Path, dst: _S, copy_function: object = ...) -> _S | None: ...
@overload
def move(src: _Path, dst: _TextPath, copy_function: object = ...) -> _TextPath | str | None: ...
@overload
def move(src: _Path, dst: _BytesPath, copy_function: object = ...) -> _BytesPath | bytes | None: ...
def _destinsrc(src: _Path, dst: _Path) -> bool: ...

@overload
def copy(src: _Path, dst: _S, *, follow_symlinks: bool = True) -> _S: ...
@overload
def copy(src: _Path, dst: PathLike[_S], *, follow_symlinks: bool = True) -> PathLike[_S] | _S: ...

@overload
def copy2(src: _Path, dst: _S, *, follow_symlinks: bool = True) -> _S: ...
@overload
def copy2(src: _Path, dst: PathLike[_S], *, follow_symlinks: bool = True) -> PathLike[_S] | _S: ...

class _RmTree(Protocol):
    avoids_symlink_attacks: bool
    def __call__(self, path: _Path, ignore_errors: bool = False, onerror: Callable | None = None, *, onexc: Callable | None = None, dir_fd: int | None = None) -> None: ...

rmtree: _RmTree

def ignore_patterns(*patterns: _S) -> Callable[[_S, list[_S]], set[_S]]: ...

def copytree(src: _Path, dst: _D, symlinks: bool = False, ignore: Callable | None = None,
             copy_function: object = ..., ignore_dangling_symlinks: bool = False,
             dirs_exist_ok: bool = False) -> _D: ...

def make_archive(base_name: str | PathLike[str], format: str, root_dir: str | PathLike[str] | None = None, base_dir: str | PathLike[str] | None = None, verbose: int = 0, dry_run: bool | int = False, owner: str | None = None, group: str | None = None, logger: object | None = None) -> str: ...
def unpack_archive(filename: str | PathLike[str], extract_dir: str | PathLike[str] | None = None, format: str | None = None, *, filter: str | None = None) -> None: ...
def get_archive_formats() -> list[tuple[str, str]]: ...
def get_unpack_formats() -> list[tuple[str, list[str], str]]: ...
def register_archive_format(name: str, function: object, extra_args: object | None = None, description: str = '') -> None: ...
def register_unpack_format(name: str, extensions: list[str], function: Callable, extra_args: object | None = None, description: str = '') -> None: ...
def unregister_archive_format(name: str) -> None: ...
def unregister_unpack_format(name: str) -> None: ...
def chown(path: str | bytes | PathLike[str] | PathLike[bytes] | int, user: str | int | None = None, group: str | int | None = None, *, dir_fd: int | None = None, follow_symlinks: bool = True) -> None: ...

class _ntuple_diskusage(NamedTuple):
    total: int
    used: int
    free: int

def disk_usage(path: str | bytes | PathLike[str] | PathLike[bytes] | int) -> _ntuple_diskusage: ...
def get_terminal_size(fallback: tuple[int, int] = (80, 24)) -> terminal_size: ...
