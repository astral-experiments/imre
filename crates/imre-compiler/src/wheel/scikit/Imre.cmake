# scikit-build-core copies Python package data after CMake installs its native files.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
file(READ "$ENV{IMRE_BUILD_TARGET}" _imre_target)
string(JSON _imre_include GET "${_imre_target}" include_dir)
string(JSON _imre_suffix GET "${_imre_target}" archive_suffix)
string(JSON _imre_link_mode GET "${_imre_target}" link_mode)
if(NOT _imre_link_mode STREQUAL "static")
  message(FATAL_ERROR "Unsupported Imre extension link mode: ${_imre_link_mode}")
endif()

function(_imre_check_install)
  get_property(modules GLOBAL PROPERTY IMRE_EXTENSION_TARGETS)
  set(expected)
  foreach(module IN LISTS modules)
    get_target_property(links "${module}" LINK_LIBRARIES)
    list(REMOVE_ITEM links Python::Module)
    if(links)
      message(FATAL_ERROR "Imre cannot bundle link dependencies for ${module}: ${links}")
    endif()
    target_include_directories("${module}" BEFORE PRIVATE "${_imre_include}")
    list(APPEND expected "$<TARGET_FILE_NAME:${module}>")
  endforeach()
  string(CONFIGURE [=[
    set(_imre_expected [==[@expected@]==])
    set(_imre_suffix [==[@_imre_suffix@]==])
    set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
    file(GLOB_RECURSE shared "${root}/*.so" "${root}/*.so.*" "${root}/*.dylib" "${root}/*.pyd" "${root}/*.dll")
    if(shared)
      message(FATAL_ERROR "unexpected shared library in Imre wheel: ${shared}")
    endif()
    if(NOT _imre_expected)
      message(FATAL_ERROR "no Imre extensions declared with Python_add_library")
    endif()
    file(GLOB_RECURSE archives "${root}/*${_imre_suffix}")
    foreach(archive IN LISTS archives)
      get_filename_component(name "${archive}" NAME)
      list(FIND _imre_expected "${name}" index)
      if(index EQUAL -1)
        message(FATAL_ERROR "unexpected archive in Imre wheel: ${archive}")
      endif()
      list(REMOVE_ITEM _imre_expected "${name}")
    endforeach()
    if(_imre_expected)
      message(FATAL_ERROR "Imre extensions missing from wheel: ${_imre_expected}")
    endif()
  ]=] check @ONLY)
  install(CODE "${check}" ALL_COMPONENTS)
endfunction()

# Append the validation after the project's own install(TARGETS ...) rules.
cmake_language(DEFER CALL _imre_check_install)
