from builtins import dict as _Dict
from typing import Any, Callable

class _SentinelObject:
    name: str

class _Sentinel:
    def __getattr__(self, name: str) -> _SentinelObject: ...

sentinel: _Sentinel
DEFAULT: _SentinelObject

_SideEffect = Exception | Callable[..., Any] | None
_Scalar = bool | int | str | bytes | None

class _DictionaryPatch:
    def __call__(self, func: Callable[..., Any]) -> Callable[..., Any]: ...
    def __enter__(self) -> dict[str, str]: ...
    def __exit__(self, *args) -> bool: ...
    def start(self) -> dict[str, str]: ...
    def stop(self) -> bool | None: ...

class _AttributePatch:
    def __enter__(self) -> Any: ...
    def __exit__(self, *args) -> None: ...
    def __call__(self, func: Callable[..., Any]) -> Callable[..., Any]: ...

class _PatchFactory:
    TEST_PREFIX: str
    def __call__(self, target: str, new: object = ..., *, create: bool = False) -> _AttributePatch: ...
    @staticmethod
    def object(target: object, attribute: str, new: object = ..., *, create: bool = False) -> _AttributePatch: ...
    def dict(self, in_dict: _Dict[str, str] | str, values: _Dict[str, str] | list[tuple[str, str]] | None = None, clear: bool = False, **kwargs: str) -> _DictionaryPatch: ...

patch: _PatchFactory

class _Call: ...

class Mock:
    called: bool
    call_count: int
    call_args: _Call | None
    call_args_list: list[_Call]
    side_effect: _SideEffect
    def __init__(self, *, name: str | None = None, side_effect: _SideEffect = None, return_value: Any = ..., **attrs: Any) -> None: ...
    def configure_mock(self, /, **attrs: Any) -> None: ...
    def __getattr__(self, name: str) -> Mock: ...
    def __call__(self, /, *args: _Scalar, **kwargs: _Scalar) -> Any: ...
    @property
    def return_value(self) -> Any: ...
    @return_value.setter
    def return_value(self, value: Any) -> None: ...
    def reset_mock(self, *, return_value: bool = False, side_effect: bool = False) -> None: ...
    def assert_not_called(self) -> None: ...
    def assert_called(self) -> None: ...
    def assert_called_once(self) -> None: ...
    def assert_called_with(self, /, *args: _Scalar, **kwargs: _Scalar) -> None: ...
    def assert_called_once_with(self, /, *args: _Scalar, **kwargs: _Scalar) -> None: ...
    def assert_any_call(self, /, *args: _Scalar, **kwargs: _Scalar) -> None: ...

class MagicMock(Mock): ...

def seal(mock: Mock) -> None: ...
