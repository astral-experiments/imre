from builtins import dict as _Dict
from typing import Any, Callable, Iterable

class _ANY(Any): ...

ANY: _ANY

class _SentinelObject:
    name: str

class _Sentinel:
    def __getattr__(self, name: str) -> _SentinelObject: ...

sentinel: _Sentinel
DEFAULT: _SentinelObject

class _DictionaryPatch:
    def __call__(self, func: Callable[..., Any]) -> Callable[..., Any]: ...
    def __enter__(self) -> dict[str, str]: ...
    def __exit__(self, *args) -> bool: ...
    def start(self) -> dict[str, str]: ...
    def stop(self) -> bool | None: ...

class _AttributePatch:
    def __enter__(self) -> Any: ...
    def __exit__(self, *args) -> bool | None: ...
    def start(self) -> Any: ...
    def stop(self) -> bool | None: ...
    def __call__(self, func: Callable[..., Any]) -> Callable[..., Any]: ...

class _PatchFactory:
    TEST_PREFIX: str
    def __call__(self, target: str, new: object = ..., spec: Any = ..., create: bool = False, spec_set: Any = ..., autospec: Any = ..., new_callable: Callable[..., Any] | None = None, **kwargs: Any) -> _AttributePatch: ...
    @staticmethod
    def object(target: object, attribute: str, new: object = ..., spec: Any = ..., create: bool = False, spec_set: Any = ..., autospec: Any = ..., new_callable: Callable[..., Any] | None = None, **kwargs: Any) -> _AttributePatch: ...
    @staticmethod
    def multiple(target: object, spec: Any = ..., create: bool = False, spec_set: Any = ..., autospec: Any = ..., new_callable: Callable[..., Any] | None = None, **kwargs: Any) -> _AttributePatch: ...
    def dict(self, in_dict: _Dict[str, str] | str, values: _Dict[str, str] | list[tuple[str, str]] | None = None, clear: bool = False, **kwargs: str) -> _DictionaryPatch: ...

patch: _PatchFactory

class _Call(tuple[Any, ...]):
    def __getattr__(self, name: str) -> _Call: ...
    def __call__(self, /, *args: Any, **kwargs: Any) -> _Call: ...
    @property
    def args(self) -> tuple[Any, ...]: ...
    @property
    def kwargs(self) -> dict[str, Any]: ...
    def call_list(self) -> _CallList: ...

class _CallList(list[_Call]): ...

call: _Call

class InvalidSpecError(Exception): ...

class NonCallableMock:
    called: bool
    call_count: int
    call_args: _Call | None
    call_args_list: _CallList
    mock_calls: _CallList
    method_calls: _CallList
    side_effect: Any
    def __init__(self, spec: object = None, *, spec_set: object = None, name: str | None = None, side_effect: Any = None, return_value: Any = ..., wraps: Any = None, unsafe: bool = False, **attrs: Any) -> None: ...
    def mock_add_spec(self, spec: object, spec_set: bool = False) -> None: ...
    def attach_mock(self, mock: NonCallableMock, attribute: str) -> None: ...
    def configure_mock(self, /, **attrs: Any) -> None: ...
    def __getattr__(self, name: str) -> Mock: ...
    @property
    def return_value(self) -> Any: ...
    @return_value.setter
    def return_value(self, value: Any) -> None: ...
    def reset_mock(self, *, return_value: bool = False, side_effect: bool = False) -> None: ...
    def assert_not_called(self) -> None: ...
    def assert_called(self) -> None: ...
    def assert_called_once(self) -> None: ...
    def assert_called_with(self, /, *args: Any, **kwargs: Any) -> None: ...
    def assert_called_once_with(self, /, *args: Any, **kwargs: Any) -> None: ...
    def assert_has_calls(self, calls: Iterable[_Call], any_order: bool = False) -> None: ...
    def assert_any_call(self, /, *args: Any, **kwargs: Any) -> None: ...

class CallableMixin:
    def __call__(self, /, *args: Any, **kwargs: Any) -> Any: ...

class Mock(CallableMixin, NonCallableMock): ...

class AsyncMock(Mock):
    await_count: int
    await_args: _Call | None
    await_args_list: _CallList
    async def __call__(self, /, *args: Any, **kwargs: Any) -> Any: ...
    def assert_not_awaited(self) -> None: ...
    def assert_awaited(self) -> None: ...
    def assert_awaited_once(self) -> None: ...
    def assert_awaited_with(self, /, *args: Any, **kwargs: Any) -> None: ...
    def assert_awaited_once_with(self, /, *args: Any, **kwargs: Any) -> None: ...
    def assert_any_await(self, /, *args: Any, **kwargs: Any) -> None: ...
    def assert_has_awaits(self, calls: Iterable[_Call], any_order: bool = False) -> None: ...

class MagicMock(Mock): ...

class ThreadingMock(Mock):
    DEFAULT_TIMEOUT: float | None
    def wait_until_called(self, *, timeout: float | None = ...) -> None: ...
    def wait_until_any_call_with(self, *args: Any, **kwargs: Any) -> None: ...

class NonCallableMagicMock(NonCallableMock): ...

class PropertyMock(Mock):
    def __get__(self, obj: object, obj_type: type | None = None) -> Any: ...
    def __set__(self, obj: object, val: Any) -> None: ...

def _callable(value: object) -> bool: ...

def create_autospec(spec: object, spec_set: bool = False, instance: bool = False, *, unsafe: bool = False, **kwargs: Any) -> Any: ...

def mock_open(mock: Mock | None = None, read_data: str | bytes = "") -> Mock: ...

def seal(mock: NonCallableMock) -> None: ...
