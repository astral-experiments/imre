from builtins import dict as _Dict

_Scalar = bool | int | str | bytes | None

class _DictionaryPatch:
    def __enter__(self) -> dict[str, str]: ...
    def __exit__(self, *args) -> bool: ...
    def start(self) -> dict[str, str]: ...
    def stop(self) -> bool | None: ...

class _PatchFactory:
    def dict(self, in_dict: _Dict[str, str], values: _Dict[str, str] | list[tuple[str, str]] | None = None, clear: bool = False, **kwargs: str) -> _DictionaryPatch: ...

patch: _PatchFactory

class _Call: ...

class Mock:
    called: bool
    call_count: int
    call_args: _Call | None
    call_args_list: list[_Call]
    side_effect: Exception | None
    def __init__(self, *, name: str | None = None, side_effect: Exception | None = None) -> None: ...
    def __getattr__(self, name: str) -> Mock: ...
    def __call__(self, /, *args: _Scalar, **kwargs: _Scalar) -> Mock: ...
    @property
    def return_value(self) -> Mock: ...
    def reset_mock(self, *, return_value: bool = False, side_effect: bool = False) -> None: ...
    def assert_not_called(self) -> None: ...
    def assert_called(self) -> None: ...
    def assert_called_once(self) -> None: ...
    def assert_called_with(self, /, *args: _Scalar, **kwargs: _Scalar) -> None: ...
    def assert_called_once_with(self, /, *args: _Scalar, **kwargs: _Scalar) -> None: ...
    def assert_any_call(self, /, *args: _Scalar, **kwargs: _Scalar) -> None: ...
