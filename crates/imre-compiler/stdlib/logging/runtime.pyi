from __imre_logging_classes__ import Handler
from logging import Logger
from typing import Protocol

type _Level = int | str

class _TextOutput(Protocol):
    @property
    def closed(self) -> bool: ...
    @property
    def encoding(self) -> str | None: ...
    @property
    def errors(self) -> str | None: ...
    def write(self, value: str, /) -> int | None: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...
    def fileno(self) -> int: ...

def _fallback(logger: Logger, level: int, msg: str, found: bool) -> None: ...

class _Lock:
    def acquire(self, blocking: object = True, timeout: float = -1.0) -> bool: ...
    def release(self) -> None: ...
    def locked(self) -> bool: ...
    def _recursion_count(self) -> int: ...
    def _is_owned(self) -> bool: ...
    def _at_fork_reinit(self) -> None: ...
    def __enter__(self, blocking: object = True, timeout: float = -1.0) -> bool: ...
    def __exit__(self, *exc: object) -> None: ...

def _lookup_handler(name: str) -> Handler | None: ...
def _file_encoding_uses_utf8() -> bool: ...
def _print_active_exception() -> None: ...
def _rename_handler(handler: Handler, old: str | None, new: str | None) -> None: ...
