# scikit-build-core copies Python package data after CMake installs its native files.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
file(READ "$ENV{RELAR_BUILD_TARGET}" _relar_target)
string(JSON _relar_include GET "${_relar_target}" include_dir)
string(JSON _relar_suffix GET "${_relar_target}" archive_suffix)
string(JSON _relar_link_mode GET "${_relar_target}" link_mode)
if(NOT _relar_link_mode STREQUAL "static")
  message(FATAL_ERROR "Unsupported Relar extension link mode: ${_relar_link_mode}")
endif()

function(_relar_check_install)
  get_property(modules GLOBAL PROPERTY RELAR_EXTENSION_TARGETS)
  set(expected)
  foreach(module IN LISTS modules)
    get_target_property(links "${module}" LINK_LIBRARIES)
    list(REMOVE_ITEM links Python::Module)
    if(links)
      message(FATAL_ERROR "Relar cannot bundle link dependencies for ${module}: ${links}")
    endif()
    target_include_directories("${module}" BEFORE PRIVATE "${_relar_include}")
    list(APPEND expected "$<TARGET_FILE_NAME:${module}>")
  endforeach()
  string(CONFIGURE [=[
    set(_relar_expected [==[@expected@]==])
    set(_relar_suffix [==[@_relar_suffix@]==])
    set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
    file(GLOB_RECURSE shared "${root}/*.so" "${root}/*.so.*" "${root}/*.dylib" "${root}/*.pyd" "${root}/*.dll")
    if(shared)
      message(FATAL_ERROR "unexpected shared library in Relar wheel: ${shared}")
    endif()
    if(NOT _relar_expected)
      message(FATAL_ERROR "no Relar extensions declared with Python_add_library")
    endif()
    file(GLOB_RECURSE archives "${root}/*${_relar_suffix}")
    foreach(archive IN LISTS archives)
      get_filename_component(name "${archive}" NAME)
      if(NOT name IN_LIST _relar_expected)
        message(FATAL_ERROR "unexpected archive in Relar wheel: ${archive}")
      endif()
      list(REMOVE_ITEM _relar_expected "${name}")
    endforeach()
    if(_relar_expected)
      message(FATAL_ERROR "Relar extensions missing from wheel: ${_relar_expected}")
    endif()
  ]=] check @ONLY)
  install(CODE "${check}" ALL_COMPONENTS)
endfunction()

# Append the validation after the project's own install(TARGETS ...) rules.
cmake_language(DEFER CALL _relar_check_install)
