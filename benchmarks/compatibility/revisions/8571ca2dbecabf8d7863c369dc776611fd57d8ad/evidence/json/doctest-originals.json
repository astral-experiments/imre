          "exc_msg": null,
          "options": {}
        },
        {
          "source": "import json\n",
          "want": "",
          "exc_msg": null,
          "options": {}
        },
        {
          "source": "def encode_complex(obj):\n    if isinstance(obj, complex):\n        return [obj.real, obj.imag]\n    raise TypeError(f'Object of type {obj.__class__.__name__} '\n                    f'is not JSON serializable')\n",
