          "options": {}
        },
        {
          "source": "from decimal import Decimal\n",
          "want": "",
          "exc_msg": null,
          "options": {}
        },
        {
          "source": "json.loads('1.1', parse_float=Decimal) == Decimal('1.1')\n",
