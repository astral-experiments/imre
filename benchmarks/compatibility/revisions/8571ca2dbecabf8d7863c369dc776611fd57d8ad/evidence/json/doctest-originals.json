          "exc_msg": null,
          "options": {}
        },
        {
          "source": "json.dumps(2 + 1j, default=encode_complex)\n",
          "want": "'[2.0, 1.0]'\n",
          "exc_msg": null,
          "options": {}
        },
        {
          "source": "json.JSONEncoder(default=encode_complex).encode(2 + 1j)\n",
