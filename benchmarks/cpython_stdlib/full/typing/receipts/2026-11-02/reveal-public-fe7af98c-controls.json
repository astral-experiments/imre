{
  "comparison": "stock vs independent native processes, ordinary and --runtime-imports kept separate",
  "driver_sources": {
    "driver.py": "import sys\nimport from_client\nimport module_client\nimport original_case\n\nif sys.argv[2] == \"from\":\n    from_client.current()\nelif sys.argv[2] == \"module\":\n    module_client.current()\nelif sys.argv[2] == \"original\":\n    original_case.current()\nelse:\n    raise AssertionError(\"unknown probe\")\n",
    "from_client.py": "import sys\nimport io\nimport typing\nfrom typing import reveal_type\n\nclass FromWitness:\n    pass\n\nobj = FromWitness()\n\ndef current():\n    if sys.argv[1] == 'core':\n        assert reveal_type(obj) is obj\n        print('identity')\n\n    if sys.argv[1] == 'metadata':\n        fn = reveal_type\n        other = typing.reveal_type\n        assert fn is other\n        params = fn.__type_params__\n        assert len(params) == 1\n        t = params[0]\n        assert isinstance(t, typing.TypeVar)\n        assert t.__name__ == 'T'\n        assert t is not typing.T\n        assert t.__infer_variance__ is True\n        assert fn.__annotations__ == {'obj': t, 'return': t}\n        print('metadata')\n\n    if sys.argv[1] == 'arguments':\n\n        try:\n            reveal_type(obj=obj)\n        except TypeError:\n            print('positional-only')\n        else:\n            raise AssertionError(\"accepted keyword obj\")\n\n    if sys.argv[1] == 'redirect':\n\n\n        captured = io.StringIO()\n        saved = sys.stderr\n        try:\n            sys.stderr = captured\n            assert reveal_type(obj) is obj\n            assert captured.getvalue() == \"Runtime type is 'FromWitness'\\n\"\n        finally:\n            sys.stderr = saved\n        print('redirected')\n\n    if sys.argv[1] == 'broken':\n\n\n        failure = RuntimeError(\"write failed\")\n\n        class BrokenStream:\n            def write(self, text):\n                raise failure\n\n        saved = sys.stderr\n        try:\n            sys.stderr = BrokenStream()\n            try:\n                reveal_type(obj)\n            except RuntimeError as error:\n                assert error is failure\n            else:\n                raise AssertionError(\"lost stderr write failure\")\n        finally:\n            sys.stderr = saved\n        print('propagated')\n\n    if sys.argv[1] == 'negative':\n        assert reveal_type(obj) is not obj\n",
    "module_client.py": "import sys\nimport io\nimport typing\n\nclass ModuleWitness:\n    pass\n\nobj = ModuleWitness()\n\ndef current():\n    if sys.argv[1] == 'core':\n        assert typing.reveal_type(obj) is obj\n        print('identity')\n\n    if sys.argv[1] == 'metadata':\n        fn = typing.reveal_type\n        other = typing.reveal_type\n        assert fn is other\n        params = fn.__type_params__\n        assert len(params) == 1\n        t = params[0]\n        assert isinstance(t, typing.TypeVar)\n        assert t.__name__ == 'T'\n        assert t is not typing.T\n        assert t.__infer_variance__ is True\n        assert fn.__annotations__ == {'obj': t, 'return': t}\n        print('metadata')\n\n    if sys.argv[1] == 'arguments':\n\n        try:\n            typing.reveal_type(obj=obj)\n        except TypeError:\n            print('positional-only')\n        else:\n            raise AssertionError(\"accepted keyword obj\")\n\n    if sys.argv[1] == 'redirect':\n\n\n        captured = io.StringIO()\n        saved = sys.stderr\n        try:\n            sys.stderr = captured\n            assert typing.reveal_type(obj) is obj\n            assert captured.getvalue() == \"Runtime type is 'ModuleWitness'\\n\"\n        finally:\n            sys.stderr = saved\n        print('redirected')\n\n    if sys.argv[1] == 'broken':\n\n\n        failure = RuntimeError(\"write failed\")\n\n        class BrokenStream:\n            def write(self, text):\n                raise failure\n\n        saved = sys.stderr\n        try:\n            sys.stderr = BrokenStream()\n            try:\n                typing.reveal_type(obj)\n            except RuntimeError as error:\n                assert error is failure\n            else:\n                raise AssertionError(\"lost stderr write failure\")\n        finally:\n            sys.stderr = saved\n        print('propagated')\n\n    if sys.argv[1] == 'negative':\n        assert typing.reveal_type(obj) is not obj\n",
    "original_case.py": "import unittest\nfrom test.test_typing import RevealTypeTests\n\nclass Result(unittest.TestResult):\n    def startTest(self, test):\n        print('START',test.id(),flush=True)\n        super().startTest(test)\n    def addSuccess(self, test):\n        print('PASS',test.id(),flush=True)\n        super().addSuccess(test)\n    def addSkip(self, test, reason):\n        print('SKIP',test.id(),repr(reason),flush=True)\n        super().addSkip(test,reason)\n    def addFailure(self, test, err):\n        print('FAIL',test.id(),repr(err[1]),flush=True)\n        super().addFailure(test,err)\n    def addError(self, test, err):\n        print('ERROR',test.id(),repr(err[1]),flush=True)\n        super().addError(test,err)\ndef current():\n    case=RevealTypeTests(\"test_reveal_type\")\n    result=Result()\n    case.run(result)\n    assert result.testsRun==1 and result.wasSuccessful() and len(result.skipped)==0\n"
  },
