  "delivered_attributes": {
    "source": "\"\"\"Read and retain an emitted extra through both original-record handlers.\"\"\"\nimport logging\n\n\nclass Capture(logging.Handler):\n    records: list[logging.LogRecord]\n\n    def __init__(self) -> None:\n        super().__init__()\n        self.records = []\n\n    def emit(self, record: logging.LogRecord | None) -> None:\n        if record is not None:\n            self.records.append(record)\n\n\ndef check() -> None:\n    parent = logging.getLogger('retained-extra')\n    child = logging.getLogger('retained-extra.child')\n    parent.propagate = False\n    child.setLevel(logging.DEBUG)\n    first = Capture()\n    second = Capture()\n    parent.addHandler(second)\n    child.addHandler(first)\n    source = {'tag': 'original'}\n    child.info('value: %s', 'kept', extra=source)\n    record = first.records[0]\n    print(record is second.records[0])\n    previous = record.tag\n    source['tag'] = 'source was edited'\n    print(str(record.tag))\n    vars(record)['tag'] = 'dictionary was edited'\n    print(str(previous))\n    print(str(second.records[0].tag))\n    del vars(record)['tag']\n    print(hasattr(record, 'tag'))\n    print(str(getattr(record, 'tag', 'fallback')))\n    print(record.getMessage())\n\n\ncheck()\n",
    "fixture_blob": "44e22db25f200cf4adbb4b4fe30db08924913df8",
    "observations": [
      "True",
      "original",
      "original",
      "dictionary was edited",
      "False",
      "fallback",
      "value: kept"
    ],
