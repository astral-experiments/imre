  "make_record_mixed_extra": {
    "source": "\"\"\"Exercise the shared event/makeRecord mapping conversion and reserved-field check.\"\"\"\nimport logging\n\n\ndef check() -> None:\n    logger = logging.getLogger(\"extra.record\")\n    record = logger.makeRecord(\"extra.record\", logging.INFO, \"source.py\", 12,\n                               \"value %s\", (\"kept\",), None,\n                               extra={\"text\": \"yes\", \"number\": 12, \"nil\": None, \"enabled\": True})\n    print(record.getMessage())\n    print(str(record.__dict__[\"text\"]))\n    print(str(record.__dict__[\"number\"]))\n    print(str(record.__dict__[\"nil\"]))\n    print(str(record.__dict__[\"enabled\"]))\n    aliased = {\"tag\": \"original\"}\n    copied = logger.makeRecord(\"extra.record\", logging.INFO, \"source.py\", 13,\n                               \"copied\", (), None, extra=aliased)\n    aliased[\"tag\"] = \"new\"\n    print(str(copied.__dict__[\"tag\"]))\n    try:\n        logger.makeRecord(\"extra.record\", logging.INFO, \"source.py\", 14,\n                          \"never returned\", (), None, extra={\"tag\": \"first\", \"message\": \"bad\"})\n    except KeyError as error:\n        print(str(error))\n    print(record.getMessage())\n\n\ncheck()\n",
    "observations": [
