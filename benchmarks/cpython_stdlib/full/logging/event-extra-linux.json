  "extra_call_order": {
    "source": "\"\"\"Check that evaluating extra runs before enablement, root setup, and dispatch.\"\"\"\nimport logging\n\n\nclass Capture(logging.Handler):\n    records: list[logging.LogRecord]\n\n    def __init__(self) -> None:\n        super().__init__()\n        self.records = []\n\n    def emit(self, record: logging.LogRecord | None) -> None:\n        if record is not None:\n            self.records.append(record)\n\n\ndef no_fields(marker: str) -> None:\n    print(marker)\n\n\ndef reject(marker: str) -> dict[str, str]:\n    print(marker)\n    raise ValueError(\"extra evaluation failed\")\n\n\ndef check() -> None:\n    print(len(logging.root.handlers))\n    try:\n        logging.warning(\"never delivered\", extra=reject(\"before root configuration\"))\n    except ValueError as exc:\n        print(str(exc))\n    print(len(logging.root.handlers))\n\n    logs = logging.getLogger(\"extra.call.order\")\n    logs.propagate = False\n    capture = Capture()\n    logs.addHandler(capture)\n    logs.setLevel(logging.WARNING)\n    logs.debug(\"disabled\", extra=no_fields(\"None while disabled\"))\n    print(len(capture.records))\n    logs.warning(\"enabled %s\", \"value\", extra=no_fields(\"None while enabled\"))\n    print(capture.records[0].getMessage())\n    try:\n        logs.error(\"never delivered\", extra=reject(\"before handler\"))\n    except ValueError as exc:\n        print(str(exc))\n    print(len(capture.records))\n\n\ncheck()\n",
    "fixture_blob": "81349fe560e7f8fcecee8adf794c7d64bb17533c",
    "observations": [
      "0",
      "before root configuration",
      "extra evaluation failed",
      "0",
      "None while disabled",
      "0",
      "None while enabled",
      "enabled value",
      "before handler",
      "extra evaluation failed",
      "1"
    ],
