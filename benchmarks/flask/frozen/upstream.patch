diff --git a/jinja2/environment.py b/jinja2/environment.py
index 0fc6e5b..85352b3 100644
--- a/jinja2/environment.py
+++ b/jinja2/environment.py
@@ -1091,0 +1092,23 @@ class Environment:
+    def compile_text(self, source: str):
+        """Compile HTML with literal text and named plain-string slots at registration."""
+        from .textprogram import TextProgram
+
+        if self.finalize is not None or self.extensions or self.is_async:
+            raise ValueError("text programs require a synchronous unextended environment")
+        if not (self.autoescape(None) if callable(self.autoescape) else self.autoescape):
+            raise ValueError("text programs require HTML autoescaping")
+        literals = [""]
+        names = []
+        for node in self.parse(source).body:
+            if type(node) is not nodes.Output:
+                raise ValueError("text programs require output nodes")
+            for child in node.nodes:
+                if type(child) is nodes.TemplateData:
+                    literals[-1] += child.data
+                elif type(child) is nodes.Name:
+                    names.append(child.name)
+                    literals.append("")
+                else:
+                    raise ValueError("text slots require a plain name")
+        return TextProgram(literals, names)
+
