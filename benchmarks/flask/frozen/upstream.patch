@@ -182,0 +185,36 @@ class Map:
+    def freeze(self) -> None:
+        """Index strict HTTP rules with literal paths or one final plain string converter."""
+        from .converters import UnicodeConverter
+        from .frozen import FrozenMap
+
+        if self.host_matching:
+            raise ValueError("host matching is not available in frozen maps")
+        index = FrozenMap()
+        rules = []
+        for rule in self.iter_rules():
+            if (rule.build_only or rule.subdomain or rule.websocket or rule.alias
+                    or rule.redirect_to or rule.defaults or not rule.strict_slashes
+                    or not rule.methods or type(rule) is not Rule):
+                raise ValueError(f"cannot freeze rule {rule}")
+            trace = rule._trace[1:]
+            capture = ""
+            if rule._converters:
+                if len(rule._converters) != 1 or not trace[-1][0]:
+                    raise ValueError(f"cannot freeze converters in {rule}")
+                capture = trace[-1][1]
+                conv = rule._converters[capture]
+                if (type(conv) is not UnicodeConverter or conv.regex != "[^/]{1,}"
+                        or len(trace) < 2 or trace[-2] != (False, "/")):
+                    raise ValueError(f"cannot freeze converter in {rule}")
+                trace = trace[:-1]
+            prefix = "".join(value for dynamic, value in trace)
+            if "//" in prefix or (len(prefix) > 1 and not capture and prefix.endswith("/")):
+                raise ValueError(f"cannot freeze slash redirection in {rule}")
+            for method in rule.methods:
+                entries = index.segments if capture else index.literals
+                if method + " " + prefix in entries:
+                    raise ValueError(f"frozen rules have overlapping {method} handlers for {prefix}")
+                index.add(method, prefix, capture, len(rules))
+            rules.append((rule, capture))
+        self._frozen = index, rules
+
