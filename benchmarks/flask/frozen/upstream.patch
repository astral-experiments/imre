diff --git a/werkzeug/wrappers/request.py b/werkzeug/wrappers/request.py
index 9f1eee1..95fc029 100644
--- a/werkzeug/wrappers/request.py
+++ b/werkzeug/wrappers/request.py
@@ -630,0 +631,10 @@ class Request(_SansIORequest):
+    def freeze(self):
+        """Snapshot method, origin-form target, media, cookies and body for a concrete view."""
+        from urllib.parse import quote
+        from .frozen import Request as FrozenRequest
+
+        target = quote(self.path, safe="/") + "?" + self.query_string.decode("ascii")
+        return FrozenRequest(
+            self.method, target, self.mimetype, self.headers.get("Cookie", ""), self.get_data()
+        )
+
diff --git a/werkzeug/wrappers/response.py b/werkzeug/wrappers/response.py
index 4707292..10e4aae 100644
--- a/werkzeug/wrappers/response.py
+++ b/werkzeug/wrappers/response.py
@@ -178,0 +179,12 @@ class Response(_SansIOResponse):
+    @classmethod
+    def from_frozen(cls, result):
+        """Construct a WSGI response from the same concrete result used by the native server."""
+        response = cls(result.body, status=result.status, content_type=result.content_type)
+        if result.allow:
+            response.headers["Allow"] = result.allow
+        if result.cookie:
+            response.headers["Set-Cookie"] = result.cookie
+        if result.cookie or result.vary_cookie:
+            response.vary.add("Cookie")
+        return response
+
