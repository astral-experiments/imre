diff --git a/flask/app.py b/flask/app.py
index cc326db..ac766d8 100644
--- a/flask/app.py
+++ b/flask/app.py
@@ -280,0 +281,36 @@ class Flask(App):
+    def freeze_routes(self) -> None:
+        """Finish registration and index the Werkzeug rules for concrete method/path lookup."""
+        from .sessions import FrozenCookieSessionInterface
+        from .sessions import SecureCookieSessionInterface
+
+        self.url_map.freeze()
+        if type(self.session_interface) is SecureCookieSessionInterface:
+            self.session_interface = FrozenCookieSessionInterface()
+
+    def bind_frozen_views(self, templates: dict[str, str]) -> None:
+        """Serve registered concrete views through normal Flask contexts and WSGI."""
+        from .frozen.state import AppState
+
+        self.freeze_routes()
+        key = self.secret_key
+        if not key:
+            raise ValueError("a signing key is required")
+        state = AppState(
+            key.encode() if isinstance(key, str) else key, self.session_interface.salt.encode(),
+            int(self.permanent_session_lifetime.total_seconds()), self.config["SESSION_COOKIE_NAME"],
+        )
+        for name, source in templates.items():
+            state.templates[name] = self.jinja_env.compile_text(source)
+
+        def adapt(view):
+            def invoke(**captures):
+                value = next(iter(captures.values()), "")
+                req = request_ctx.request.freeze()
+                result = view(req, value, state)
+                result.vary_cookie = req.session_accessed
+                return self.response_class.from_frozen(result)
+            return invoke
+
+        for endpoint, view in self.view_functions.items():
+            self.view_functions[endpoint] = adapt(view)
+
diff --git a/flask/sessions.py b/flask/sessions.py
index ad35770..0dc2a55 100644
--- a/flask/sessions.py
+++ b/flask/sessions.py
@@ -385,0 +386,11 @@ class SecureCookieSessionInterface(SessionInterface):
+
+
+class FrozenCookieSessionInterface(SecureCookieSessionInterface):
+    """Defer signer construction until a frozen WSGI app receives a cookie."""
+
+    def open_session(self, app: Flask, request: Request) -> SecureCookieSession | None:
+        if not app.secret_key:
+            return None
+        if not request.cookies.get(self.get_cookie_name(app)):
+            return self.session_class()
+        return super().open_session(app, request)
