  "runner_source": "import datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\n\nroot = Path('/home/dev-user/code/oss/relar')\npython = '/home/dev-user/code/oss/penguin-uv-benchmark/python/cpython-3.14.5-linux-x86_64-gnu/bin/python3.14'\nrecord_path = root / 'benchmarks/local/inventory-final-session.json'\ncache_probe = r'''\nimport hashlib, importlib.util, json, pathlib, struct, sys\nrecords = {}\nfor package in sys.argv[1:]:\n    for source in sorted(pathlib.Path(package).rglob('*.py')):\n        cached = pathlib.Path(importlib.util.cache_from_source(str(source)))\n        data = cached.read_bytes()\n        content = source.read_bytes()\n        assert data[:4] == importlib.util.MAGIC_NUMBER, source\n        flags = int.from_bytes(data[4:8], 'little')\n        if flags & 1:\n            assert data[8:16] == importlib.util.source_hash(content), source\n        else:\n            timestamp, size = struct.unpack('<II', data[8:16])\n            assert timestamp == (int(source.stat().st_mtime) & 0xffffffff), source\n            assert size == (len(content) & 0xffffffff), source\n        records[str(source)] = {'source_sha256': hashlib.sha256(content).hexdigest(), 'cache_path': str(cached), 'cache_sha256': hashlib.sha256(data).hexdigest(), 'cache_bytes': len(data), 'flags': flags, 'source_mtime_ns': source.stat().st_mtime_ns, 'valid_header': True}\nprint(json.dumps({'python': sys.version, 'cache_tag': sys.implementation.cache_tag, 'magic': importlib.util.MAGIC_NUMBER.hex(), 'pycache_prefix': sys.pycache_prefix, 'dont_write_bytecode': sys.dont_write_bytecode, 'files': records}))\n'''\n\ndef git(*arguments):\n    return subprocess.check_output(['git', *arguments], cwd=root, text=True).strip()\n\ndef caches():\n    command = [python, '-I', '-c', cache_probe, str(root / 'examples/inventory_reconciliation'), str(root / 'examples/incremental_planner')]\n    return json.loads(subprocess.check_output(command, cwd=root, text=True))\n\nrecord = {'started_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'source_commit': git('rev-parse', 'HEAD'), 'git_status_before': git('status', '--porcelain'), 'runner_source': Path(__file__).read_text(), 'runs': {}, 'bytecode_before': caches()}\nassert not record['git_status_before'], 'Measured source checkout must be clean'\nassert record['source_commit'] == 'edbbab93b26ccca638c7bf74336baef0d0fab4cd'\n\ndef save():\n    record_path.write_text(json.dumps(record, indent=2) + '\\n')\n\nsave()\nfor mode in ('normal', 'lto'):\n    command = ['python3', 'benchmarks/inventory_benchmark.py',\n        '--compiler', 'benchmarks/local/comprehension-tools-final/relar',\n        '--runtime', 'benchmarks/local/comprehension-tools-final/' + ('librelar_runtime_lto.a' if mode == 'lto' else 'librelar_runtime.a'),\n        '--relar-build-record', 'benchmarks/local/comprehension-tools-final/build-record.json',\n        '--rust-bigint', f'benchmarks/local/inventory-reference-final-{mode}/inventory-bigint',\n        '--rust-build-record', f'benchmarks/local/inventory-reference-final-{mode}/build-record.json',\n        '--baseline', f'benchmarks/local/layout-{mode}-final/incremental_planner',\n        '--baseline-record', f'benchmarks/local/layout-{mode}-final.json',\n        '--python', python, '--clang', 'clang-18', '--target', 'x86_64-unknown-linux-gnu',\n        '--samples', '30', '--warmups', '2', '--cpu', '0',\n        '--artifact-dir', f'benchmarks/local/inventory-{mode}-final',\n        '--output', f'benchmarks/local/inventory-{mode}-final.json']\n    if mode == 'lto':\n        command += ['--lto-linker', str(root / 'benchmarks/local/batch-linker/ld.lld')]\n    record['runs'][mode] = {'command': command, 'started_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}\n    save()\n    print('Starting ' + mode + ' inventory and unchanged-control measurements', flush=True)\n    result = subprocess.run(command, cwd=root, capture_output=True, text=True)\n    output = result.stdout + result.stderr\n    log = root / f'benchmarks/local/inventory-{mode}-final.log'\n    log.write_text(output)\n    print(output, end='', flush=True)\n    record['runs'][mode].update(returncode=result.returncode, completed_at_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), log_sha256=hashlib.sha256(log.read_bytes()).hexdigest())\n    save()\n    result.check_returncode()\n    result_path = root / f'benchmarks/local/inventory-{mode}-final.json'\n    record['runs'][mode]['record_sha256'] = hashlib.sha256(result_path.read_bytes()).hexdigest()\n    assert caches() == record['bytecode_before'], 'Python package caches changed during measurement'\n    assert git('rev-parse', 'HEAD') == record['source_commit']\n    assert not git('status', '--porcelain')\n    save()\nrecord['bytecode_after'] = caches()\nrecord['git_status_after'] = git('status', '--porcelain')\nrecord['completed_at_utc'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nsave()\nprint('Both modes complete; source, bytecode caches, and build identities preserved', flush=True)\n",
