  "runner_source": "\"\"\"Run only after final tools are frozen and task-owned heavy jobs have stopped.\"\"\"\n\nimport argparse\nimport hashlib\nimport json\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nLOCAL = ROOT / \"benchmarks/local\"\nSESSION = LOCAL / \"keyword-arguments-final-session.json\"\nSNAPSHOT = LOCAL / \"keyword-arguments-baseline-source\"\nCACHE_PROBE = r\"\"\"\nimport hashlib, importlib.util, json, pathlib, struct, sys\nrecords = {}\nfor source in sorted(pathlib.Path(sys.argv[1]).rglob('*.py')):\n    cached = pathlib.Path(importlib.util.cache_from_source(str(source)))\n    data, content = cached.read_bytes(), source.read_bytes()\n    assert data[:4] == importlib.util.MAGIC_NUMBER, source\n    flags = int.from_bytes(data[4:8], 'little')\n    if flags & 1:\n        assert data[8:16] == importlib.util.source_hash(content), source\n    else:\n        timestamp, size = struct.unpack('<II', data[8:16])\n        assert timestamp == (int(source.stat().st_mtime) & 0xffffffff), source\n        assert size == (len(content) & 0xffffffff), source\n    records[str(source)] = {'source_sha256': hashlib.sha256(content).hexdigest(), 'cache_path': str(cached), 'cache_sha256': hashlib.sha256(data).hexdigest(), 'cache_bytes': len(data), 'flags': flags, 'source_mtime_ns': source.stat().st_mtime_ns, 'valid_header': True}\nprint(json.dumps({'python': sys.version, 'cache_tag': sys.implementation.cache_tag, 'magic': importlib.util.MAGIC_NUMBER.hex(), 'pycache_prefix': sys.pycache_prefix, 'dont_write_bytecode': sys.dont_write_bytecode, 'files': records}))\n\"\"\"\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef git(*arguments):\n    return subprocess.check_output([\"git\", \"-C\", str(ROOT), *arguments])\n\n\ndef clean_sources(tools, expected_head=None):\n    head = git(\"rev-parse\", \"HEAD\").decode().strip()\n    if (\n        git(\"status\", \"--porcelain\")\n        or expected_head is not None\n        and head != expected_head\n    ):\n        raise RuntimeError(\"final comparisons require one unchanged clean checkout\")\n    record = json.loads((tools / \"build-record.json\").read_text())\n    if (\n        record[\"git_head\"] != head\n        or record[\"git_status\"]\n        or not record[\"compiled_sources_match_commit\"]\n    ):\n        raise RuntimeError(\n            \"final tool build record must identify the same clean commit\"\n        )\n    for name, expected in record[\"source_sha256\"].items():\n        if (\n            sha(ROOT / name) != expected\n            or hashlib.sha256(git(\"show\", head + \":\" + name)).hexdigest() != expected\n        ):\n            raise RuntimeError(\n                \"frozen compiled source differs from clean HEAD: \" + name\n            )\n    application_sources = {}\n    for path in sorted((ROOT / \"examples/inventory_reconciliation\").rglob(\"*.py\")):\n        name = str(path.relative_to(ROOT))\n        application_sources[name] = sha(path)\n        if (\n            hashlib.sha256(git(\"show\", head + \":\" + name)).hexdigest()\n            != application_sources[name]\n        ):\n            raise RuntimeError(\"application source differs from clean HEAD: \" + name)\n    return {\n        \"head\": head,\n        \"dirty\": False,\n        \"all_compiled_sources_match_commit\": True,\n        \"application_source_sha256\": application_sources,\n        \"build_record_sha256\": sha(tools / \"build-record.json\"),\n    }\n\n\ndef snapshot_identity():\n    manifest = json.loads((SNAPSHOT / \"manifest.json\").read_text())\n    sources = {\n        str(path.relative_to(SNAPSHOT)): sha(path)\n        for path in sorted((SNAPSHOT / \"inventory_reconciliation\").rglob(\"*.py\"))\n    }\n    if manifest[\"sources\"] != sources:\n        raise RuntimeError(\"preserved source snapshot differs from manifest\")\n    current = {\n        str(path.relative_to(ROOT / \"examples\")): sha(path)\n        for path in sorted((ROOT / \"examples/inventory_reconciliation\").rglob(\"*.py\"))\n    }\n    changes = {\n        name: {\n            \"baseline_sha256\": sources.get(name),\n            \"current_sha256\": current.get(name),\n        }\n        for name in sorted(sources.keys() | current.keys())\n        if sources.get(name) != current.get(name)\n    }\n    if set(changes) != {\n        \"inventory_reconciliation/__main__.py\",\n        \"inventory_reconciliation/load.py\",\n        \"inventory_reconciliation/model.py\",\n        \"inventory_reconciliation/reconcile.py\",\n        \"inventory_reconciliation/render.py\",\n    }:\n        raise RuntimeError(\n            \"this comparison expects the five migrated keyword-argument source files\"\n        )\n    for value in manifest[\"baseline_records\"].values():\n        if (\n            sha(Path(value[\"record_path\"])) != value[\"record_sha256\"]\n            or sha(Path(value[\"binary_path\"])) != value[\"binary_sha256\"]\n        ):\n            raise RuntimeError(\"preserved optimized baseline artifact changed\")\n        if sha(Path(value[\"ir_path\"])) != value[\"ir_sha256\"]:\n            raise RuntimeError(\"preserved baseline generated LLVM changed\")\n    frozen = manifest[\"frozen_tools\"]\n    if sha(Path(frozen[\"build_record_path\"])) != frozen[\"build_record_sha256\"]:\n        raise RuntimeError(\"preserved baseline build record changed\")\n    for name, expected in frozen[\"files\"].items():\n        if sha(ROOT / name) != expected:\n            raise RuntimeError(\"preserved baseline compiler/runtime changed: \" + name)\n    return {\n        \"manifest_path\": str(SNAPSHOT / \"manifest.json\"),\n        \"manifest_sha256\": sha(SNAPSHOT / \"manifest.json\"),\n        \"snapshot_root\": str(SNAPSHOT),\n        \"recorded_sources\": sources,\n        \"current_sources\": current,\n        \"changed_sources\": changes,\n    }\n\n\ndef reference_identity():\n    path = LOCAL / \"keyword-arguments-reference-final-freeze.json\"\n    freeze = json.loads(path.read_text())\n    for name, expected in freeze[\"sources\"].items():\n        if (\n            sha(ROOT / \"benchmarks/reference/inventory_reconciliation\" / name)\n            != expected\n        ):\n            raise RuntimeError(\n                \"Rust reference source changed after preparation: \" + name\n            )\n    for item in freeze[\"builds\"].values():\n        for kind in (\"record\", \"binary\", \"log\"):\n            if sha(Path(item[kind + \"_path\"])) != item[kind + \"_sha256\"]:\n                raise RuntimeError(\"frozen Rust reference \" + kind + \" changed\")\n    return {\"path\": str(path), \"sha256\": sha(path), \"record\": freeze}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\n        \"--tools\", type=Path, default=LOCAL / \"keyword-arguments-tools-final\"\n    )\n    parser.add_argument(\n        \"--expected-head\", required=True, help=\"full clean measured source commit\"\n    )\n    args = parser.parse_args()\n    tools = args.tools.resolve(strict=True)\n    if SESSION.exists():\n        raise RuntimeError(\"final session record must be new: \" + str(SESSION))\n    if len(args.expected_head) != 40 or any(\n        character not in \"0123456789abcdef\" for character in args.expected_head\n    ):\n        parser.error(\"--expected-head must be a full lowercase Git commit hash\")\n    before = clean_sources(tools, args.expected_head)\n    snapshot_before = snapshot_identity()\n    reference_before = reference_identity()\n    if reference_before[\"record\"][\"clean_source_commit\"] != before[\"head\"]:\n        raise RuntimeError(\n            \"final Rust reference freeze must identify the same clean commit\"\n        )\n    old_normal = json.loads((LOCAL / \"scalar-fstrings-normal-final.json\").read_text())\n    python = old_normal[\"method\"][\"commands\"][\"inventory\"][\"cpython\"][0]\n    cache_prepare = [\n        python,\n        \"-I\",\n        \"-m\",\n        \"compileall\",\n        \"-q\",\n        str(ROOT / \"examples/inventory_reconciliation\"),\n    ]\n    prepared = subprocess.run(cache_prepare, cwd=ROOT, capture_output=True, check=True)\n\n    def caches():\n        command = [\n            python,\n            \"-I\",\n            \"-c\",\n            CACHE_PROBE,\n            str(ROOT / \"examples/inventory_reconciliation\"),\n        ]\n        return json.loads(subprocess.check_output(command, cwd=ROOT, text=True))\n\n    session = {\n        \"command\": [sys.executable, *sys.argv],\n        \"launcher_sha256\": sha(Path(__file__)),\n        \"runner_source\": Path(__file__).read_text(),\n        \"before\": before,\n        \"runs\": {},\n        \"started_at_utc\": datetime.now(timezone.utc).isoformat(),\n        \"source_commit\": before[\"head\"],\n        \"git_status_before\": \"\",\n        \"baseline_source_before\": snapshot_before,\n        \"reference_before\": reference_before,\n        \"cache_preparation\": {\n            \"command\": cache_prepare,\n            \"returncode\": prepared.returncode,\n            \"stdout_sha256\": hashlib.sha256(prepared.stdout).hexdigest(),\n            \"stderr_sha256\": hashlib.sha256(prepared.stderr).hexdigest(),\n            \"timed\": False,\n        },\n        \"bytecode_before\": caches(),\n    }\n    for mode in (\"normal\", \"lto\"):\n        guard = clean_sources(tools, before[\"head\"])\n        old_path = LOCAL / f\"scalar-fstrings-{mode}-final.json\"\n        old = json.loads(old_path.read_text())\n        old_compile = old[\"method\"][\"compile_commands\"][\"inventory\"]\n        clang = old_compile[old_compile.index(\"--clang\") + 1]\n        output = LOCAL / f\"keyword-arguments-{mode}-final.json\"\n        if output.exists() or output.with_suffix(\"\").exists():\n            raise RuntimeError(\"final output must be new: \" + str(output))\n        command = [\n            sys.executable,\n            \"-u\",\n            str(ROOT / \"benchmarks/inventory_benchmark.py\"),\n            \"--compiler\",\n            str(tools / \"relar\"),\n            \"--runtime\",\n            str(\n                tools\n                / (\"librelar_runtime_lto.a\" if mode == \"lto\" else \"librelar_runtime.a\")\n            ),\n            \"--relar-build-record\",\n            str(tools / \"build-record.json\"),\n            \"--rust-bigint\",\n            str(LOCAL / f\"keyword-arguments-reference-final-{mode}/inventory-bigint\"),\n            \"--rust-build-record\",\n            str(LOCAL / f\"keyword-arguments-reference-final-{mode}/build-record.json\"),\n            \"--inventory-baseline\",\n            str(LOCAL / f\"scalar-fstrings-{mode}-final/inventory_reconciliation\"),\n            \"--inventory-baseline-record\",\n            str(old_path),\n            \"--inventory-baseline-source-root\",\n            str(SNAPSHOT),\n            \"--python\",\n            python,\n            \"--clang\",\n            clang,\n            \"--target\",\n            \"x86_64-unknown-linux-gnu\",\n            \"--samples\",\n            \"48\",\n            \"--warmups\",\n            \"2\",\n            \"--cpu\",\n            \"0\",\n            \"--output\",\n            str(output),\n            \"--artifact-dir\",\n            str(output.with_suffix(\"\")),\n        ]\n        if mode == \"lto\":\n            command += [\"--lto-linker\", str(LOCAL / \"batch-linker/ld.lld\")]\n        log_path = output.with_suffix(\".log\")\n        item = {\n            \"mode\": mode,\n            \"command\": command,\n            \"source_guard\": guard,\n            \"started_at_utc\": datetime.now(timezone.utc).isoformat(),\n        }\n        session[\"runs\"][mode] = item\n        SESSION.write_text(json.dumps(session, indent=2) + \"\\n\")\n        print(\"Starting final \" + mode, flush=True)\n        with log_path.open(\"w\") as log:\n            process = subprocess.Popen(\n                command,\n                cwd=ROOT,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.STDOUT,\n                text=True,\n            )\n            for line in process.stdout:\n                log.write(line)\n                log.flush()\n                print(line, end=\"\", flush=True)\n            status = process.wait()\n        item.update(\n            returncode=status,\n            completed_at_utc=datetime.now(timezone.utc).isoformat(),\n            log_sha256=sha(log_path),\n        )\n        if output.exists():\n            item[\"record_sha256\"] = sha(output)\n        SESSION.write_text(json.dumps(session, indent=2) + \"\\n\")\n        if status:\n            raise SystemExit(status)\n        item[\"source_guard_after\"] = clean_sources(tools, before[\"head\"])\n        if caches() != session[\"bytecode_before\"]:\n            raise RuntimeError(\"Python package cache bytes changed during measurement\")\n        if snapshot_identity() != snapshot_before:\n            raise RuntimeError(\"baseline source snapshot changed during measurement\")\n        if reference_identity() != reference_before:\n            raise RuntimeError(\"Rust reference changed during measurement\")\n        old_ir = Path(old_compile[old_compile.index(\"--emit-llvm\") + 1])\n        new_ir = output.with_suffix(\"\") / \"inventory_reconciliation.ll\"\n        item[\"generated_ir_comparison\"] = {\n            \"baseline_path\": str(old_ir),\n            \"baseline_sha256\": sha(old_ir),\n            \"current_path\": str(new_ir),\n            \"current_sha256\": sha(new_ir),\n            \"byte_identical\": old_ir.read_bytes() == new_ir.read_bytes(),\n        }\n        SESSION.write_text(json.dumps(session, indent=2) + \"\\n\")\n    session.update(\n        bytecode_after=caches(),\n        baseline_source_after=snapshot_identity(),\n        reference_after=reference_identity(),\n        git_status_after=git(\"status\", \"--porcelain\").decode(),\n        completed_at_utc=datetime.now(timezone.utc).isoformat(),\n    )\n    if sha(Path(__file__)) != session[\"launcher_sha256\"]:\n        raise RuntimeError(\"launcher changed during measurement\")\n    SESSION.write_text(json.dumps(session, indent=2) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
