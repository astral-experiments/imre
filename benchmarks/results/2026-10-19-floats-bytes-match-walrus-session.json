    "source": "\"\"\"Print or execute unchanged-inventory comparisons after the final tool freeze.\"\"\"\n\nimport argparse\nimport hashlib\nimport importlib.util\nimport json\nimport shlex\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nROOT = Path('/home/dev-user/code/oss/relar')\nHERE = Path(__file__).resolve().parent\nMANIFEST = HERE / 'prepared-manifest.json'\nSPEC = importlib.util.spec_from_file_location(\n    'sequence_launcher', ROOT / 'benchmarks/local/sequence-access-final-launch.py'\n)\nPRIOR = importlib.util.module_from_spec(SPEC)\nSPEC.loader.exec_module(PRIOR)\n\n\ndef sha(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef baseline_guard():\n    prepared = json.loads(MANIFEST.read_text())\n    sources = {\n        str(path.relative_to(ROOT / 'examples')): sha(path)\n        for path in sorted((ROOT / 'examples/inventory_reconciliation').rglob('*.py'))\n    }\n    identities = {}\n    for mode in ('normal', 'lto'):\n        value = prepared[mode]\n        if sources != value['sources']:\n            raise RuntimeError('inventory source changed from the preserved sequence milestone')\n        paths = {\n            **value['paths'],\n            'comparison': value['comparison'],\n            'published_record': value['published_record'],\n            'rust_build_record': value['rust_build_record'],\n        }\n        expected = {\n            **value['sha256'],\n            'comparison': value['comparison_sha256'],\n            'published_record': value['published_record_sha256'],\n            'rust_build_record': value['rust_build_record_sha256'],\n        }\n        current = {key: sha(path) for key, path in paths.items()}\n        if current != expected:\n            raise RuntimeError('preserved comparison or tool changed: ' + mode)\n        identities[mode] = current\n    if sha(prepared['preserved_tools']['path']) != prepared['preserved_tools']['sha256']:\n        raise RuntimeError('preserved sequence build record changed')\n    return {'sources': sources, 'sha256': identities, 'manifest_sha256': sha(MANIFEST)}\n\n\ndef command_for(mode, tools, output_dir):\n    prepared = json.loads(MANIFEST.read_text())[mode]\n    paths = prepared['paths']\n    command = [\n        sys.executable, '-u', str(ROOT / 'benchmarks/inventory_benchmark.py'),\n        '--compiler', str(tools / 'relar'),\n        '--runtime', str(tools / ('librelar_runtime_lto.a' if mode == 'lto' else 'librelar_runtime.a')),\n        '--relar-build-record', str(tools / 'build-record.json'),\n        '--rust-bigint', paths['rust_bigint'],\n        '--rust-build-record', prepared['rust_build_record'],\n        '--inventory-baseline', paths['inventory_binary'],\n        '--inventory-baseline-record', prepared['comparison'],\n        '--python', paths['python'], '--clang', paths['clang'],\n        '--target', 'x86_64-unknown-linux-gnu',\n        '--samples', '48', '--warmups', '2', '--cpu', '0',\n        '--output', str(output_dir / (mode + '.json')),\n        '--artifact-dir', str(output_dir / mode),\n    ]\n    if mode == 'lto':\n        command += ['--lto-linker', paths['lto_linker']]\n    return command\n\n\ndef cache_state(python):\n    return json.loads(subprocess.check_output([\n        python, '-I', '-c', PRIOR.CACHE_PROBE,\n        str(ROOT / 'examples/inventory_reconciliation'),\n    ], cwd=ROOT, text=True))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--tools', required=True, type=Path)\n    parser.add_argument('--expected-head')\n    parser.add_argument('--output-dir', type=Path,\n                        default=ROOT / 'benchmarks/local/four-feature-inventory-regression')\n    parser.add_argument('--execute', action='store_true',\n                        help='run only after the parent confirms the tool freeze and heavy-work stop')\n    args = parser.parse_args()\n    tools, output_dir = args.tools.resolve(), args.output_dir.resolve()\n    commands = {mode: command_for(mode, tools, output_dir) for mode in ('normal', 'lto')}\n    if not args.execute:\n        for mode, command in commands.items():\n            print(mode + ':\\n' + shlex.join(command) + '\\n')\n        return\n    if args.expected_head is None or len(args.expected_head) != 40:\n        parser.error('--execute requires the full --expected-head commit')\n    if output_dir.exists():\n        raise RuntimeError('output directory must be new; preserve all earlier evidence')\n    before = PRIOR.clean_sources(tools, args.expected_head)\n    baseline_before = baseline_guard()\n    python = json.loads(MANIFEST.read_text())['normal']['paths']['python']\n    preparation = [python, '-I', '-m', 'compileall', '-q',\n                   str(ROOT / 'examples/inventory_reconciliation')]\n    subprocess.run(preparation, cwd=ROOT, check=True)\n    cache_before = cache_state(python)\n    output_dir.mkdir(parents=True)\n    session_path = output_dir / 'session.json'\n    session = {\n        'source_commit': args.expected_head,\n        'started_at_utc': datetime.now(timezone.utc).isoformat(),\n        'source_guard_before': before,\n        'baseline_guard_before': baseline_before,\n        'launcher': {'path': str(Path(__file__)), 'sha256': sha(__file__),\n                     'source': Path(__file__).read_text()},\n        'prior_launcher': {'path': str(PRIOR.__file__), 'sha256': sha(PRIOR.__file__)},\n        'cache_preparation': {'command': preparation, 'timed': False},\n        'bytecode_before': cache_before,\n        'runs': {},\n    }\n\n    def save():\n        session_path.write_text(json.dumps(session, indent=2) + '\\n')\n\n    save()\n    for mode, command in commands.items():\n        if PRIOR.clean_sources(tools, args.expected_head) != before:\n            raise RuntimeError('frozen sources changed before ' + mode)\n        if baseline_guard() != baseline_before:\n            raise RuntimeError('preserved inputs changed before ' + mode)\n        log_path = output_dir / (mode + '.log')\n        item = {'command': command, 'started_at_utc': datetime.now(timezone.utc).isoformat()}\n        session['runs'][mode] = item\n        save()\n        print('Starting ' + mode, flush=True)\n        with log_path.open('w') as log:\n            result = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)\n        item.update(returncode=result.returncode,\n                    completed_at_utc=datetime.now(timezone.utc).isoformat(),\n                    log_sha256=sha(log_path))\n        record_path = output_dir / (mode + '.json')\n        if record_path.exists():\n            item['record_sha256'] = sha(record_path)\n        save()\n        print(log_path.read_text(), end='', flush=True)\n        if result.returncode:\n            raise SystemExit(result.returncode)\n        if PRIOR.clean_sources(tools, args.expected_head) != before:\n            raise RuntimeError('frozen sources changed during ' + mode)\n        if baseline_guard() != baseline_before or cache_state(python) != cache_before:\n            raise RuntimeError('preserved inputs or Python bytecode changed during ' + mode)\n        old = json.loads(Path(json.loads(MANIFEST.read_text())[mode]['comparison']).read_text())\n        old_command = old['method']['compile_commands']['inventory']\n        old_ir = Path(old_command[old_command.index('--emit-llvm') + 1])\n        current_ir = output_dir / mode / 'inventory_reconciliation.ll'\n        item['generated_ir'] = {'baseline_sha256': sha(old_ir), 'current_sha256': sha(current_ir),\n                                'byte_identical': old_ir.read_bytes() == current_ir.read_bytes()}\n        save()\n    session.update(completed_at_utc=datetime.now(timezone.utc).isoformat(),\n                   source_guard_after=PRIOR.clean_sources(tools, args.expected_head),\n                   baseline_guard_after=baseline_guard(), bytecode_after=cache_state(python))\n    save()\n    print('Saved ' + str(session_path), flush=True)\n\n\nif __name__ == '__main__':\n    main()\n"
  },
