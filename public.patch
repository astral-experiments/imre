diff --git a/tests/fixtures/io_buffered_writer_callbacks.py b/tests/fixtures/io_buffered_writer_callbacks.py
new file mode 100644
index 00000000..3533c4e7
--- /dev/null
+++ b/tests/fixtures/io_buffered_writer_callbacks.py
@@ -0,0 +1,43 @@
+from _io import BufferedWriter
+from io import RawIOBase
+
+
+class Raw(RawIOBase):
+    def __init__(self):
+        self.chunks = []
+        self.counts = []
+
+    def writable(self):
+        return True
+
+    def write(self, view):
+        assert isinstance(view, memoryview)
+        assert view.readonly and view.obj is None and memoryview(view).obj is None
+        count = self.counts.pop(0) if self.counts else len(view)
+        if count is not None and 0 <= count <= len(view):
+            self.chunks.append(bytes(view)[:count])
+        return count
+
+
+raw = Raw()
+writer = BufferedWriter(raw, 4)
+assert writer.raw is raw
+assert writer.write(bytearray(b"abc")) == 3 and not raw.chunks
+raw.counts = [1, None]
+try:
+    writer.write(b"defgh")
+except BlockingIOError as exc:
+    assert exc.characters_written == 2
+else:
+    raise AssertionError("write did not block")
+assert writer.write(b"fgh") == 3
+raw.counts = [4]
+try:
+    writer.flush()
+except OSError:
+    pass
+else:
+    raise AssertionError("overcount accepted")
+assert writer.detach() is raw
+assert b"".join(raw.chunks) == b"abcdefgh"
+raw.close()
diff --git a/tests/fixtures/io_buffered_writer_shutdown.py b/tests/fixtures/io_buffered_writer_shutdown.py
new file mode 100644
index 00000000..ec73adaa
--- /dev/null
+++ b/tests/fixtures/io_buffered_writer_shutdown.py
@@ -0,0 +1,37 @@
+import sys
+from _io import BufferedWriter, FileIO
+
+
+class Raw:
+    def __init__(self, path):
+        self.file = FileIO(path, "wb")
+        self.temporarily_closed = False
+
+    def writable(self):
+        return True
+
+    def tell(self):
+        return self.file.tell()
+
+    @property
+    def closed(self):
+        return self.temporarily_closed or self.file.closed
+
+    def write(self, view):
+        return self.file.write(view)
+
+    def close(self):
+        return self.file.close()
+
+
+writer = BufferedWriter(Raw(sys.argv[1]), 8)
+assert writer.write(b"abc") == 3
+if sys.argv[2] == "close":
+    writer.close()
+elif sys.argv[2] == "temporary-close":
+    raw = writer.raw
+    raw.temporarily_closed = True
+    writer.close()
+    raw.temporarily_closed = False
+    writer.flush()
+    writer.close()
