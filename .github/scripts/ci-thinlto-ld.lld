#!/bin/sh
# Only the full suite runs up to two linkers concurrently. The smoke suite
# has one linker and can use the runner's full CPU budget.
linkers=1
if [ "${FULL_THINLTO:-false}" = true ]; then
    linkers=2
fi
jobs=$(( $(nproc) / linkers ))
if [ "$jobs" -lt 1 ]; then
    jobs=1
fi
exec "$IMRE_CI_LLD" --thinlto-cache-dir="$IMRE_CI_LTO_CACHE" --thinlto-jobs="$jobs" "$@"
