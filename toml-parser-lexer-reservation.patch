+#[test]
+fn sparse_input_has_a_bounded_reservation() {
+    let input = " ".repeat(1024 * 1024);
+    let tokens = crate::Source::new(&input).lex().into_vec();
+    assert_eq!(tokens.len(), 2); // Whitespace and EOF
+    assert!(
+        tokens.capacity() <= 4096,
+        "reserved {} slots",
+        tokens.capacity()
+    );
